# R / RStudio
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Secrets -- never commit
.Renviron

# OS / IDE / Python noise
.DS_Store
.idea/
__pycache__/

# Quarto cache
.quarto/
/.quarto/
**/*.quarto_ipynb

# Derived data -- regenerated by the pipeline, shipped via DOI archive.
#
# TWO ENTRIES FOR ONE TREE. The real directory is _2_output; 2_output is a symlink to it. The
# underscore prefix is what keeps Quarto's project scan out of 1.87 million files, which is the
# difference between a render starting in one second and in eighty-five. The symlink is what keeps
# every path in 1_code working unchanged.
#
# 2_output carries NO trailing slash: it is a symlink, which is a file rather than a directory, and
# a trailing-slash pattern does not match it. With the slash git would start reporting the symlink
# as untracked.
2_output
_2_output/
0_data/
0_sample/
0_scratch/

# Superseded code and rendered output.
_BackUps/
_rendered/

# In-repo archives. Present on disk as a working reference during the rewrite; moved to
# ContractsBackUp/ at release. Tracked once, then untracked -- git history holds them.
#
# NOTE THE SINGULAR. _BackUps/ above is the repository-root archive; these two are inside
# 1_code/ and were never matched by it.
1_code/_BackUp/
1_code/_Migration/
*.BACKUP


# _Tests/ is scratch: quick probes, run once, moved on. Untracked for the same reason as
# _BackUp/ -- present on disk, absent from a reviewer's clone.
#
# TWO EXCEPTIONS, AND BOTH EARN IT. Parse-Check.R is the mechanical gate run before any
# delivery. 04D-Preflight.R is cited as evidence in 04D's published prose -- it is the sweep
# the 8,000-document chunk size comes from -- so a reviewer must be able to open it.
#
# NOTE THE /* RATHER THAN /. Git cannot re-include a file whose parent directory is excluded.
1_code/_Tests/*
!1_code/_Tests/Parse-Check.R
!1_code/_Tests/04D-Preflight.R
# The four matcon tests earn their place the same way: they are the delivery gate for
# contracts-extract, and they are what proves the Python freeze changed nothing.
!1_code/_Tests/Test-MatCon-*.R